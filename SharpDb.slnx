<Solution>
  <!--
    The production projects. src/SharpDb is the host executable; it is the
    only project that references the Providers (ADR 0004).
  -->
  <Project Path="src/SharpDb.Abstractions/SharpDb.Abstractions.csproj" />
  <Project Path="src/SharpDb.Core/SharpDb.Core.csproj" />
  <Project Path="src/SharpDb.Provider.MsSql/SharpDb.Provider.MsSql.csproj" />
  <Project Path="src/SharpDb.Provider.MySql/SharpDb.Provider.MySql.csproj" />
  <Project Path="src/SharpDb.Provider.Oracle/SharpDb.Provider.Oracle.csproj" />
  <Project Path="src/SharpDb.Provider.PostgreSql/SharpDb.Provider.PostgreSql.csproj" />
  <Project Path="src/SharpDb.Provider.Sqlite/SharpDb.Provider.Sqlite.csproj" />
  <Project Path="src/SharpDb/SharpDb.csproj" />

  <!--
    The test projects, each mirroring one production layer, plus the shared
    Provider contract: the assertions every engine runs, which is where the
    Provider port is verified as one contract rather than three lookalikes
    (ADR 0003).
  -->
  <Project Path="tests/SharpDb.Core.Tests/SharpDb.Core.Tests.csproj" />
  <Project Path="tests/SharpDb.Provider.Contract/SharpDb.Provider.Contract.csproj" />
  <Project Path="tests/SharpDb.Provider.MsSql.Tests/SharpDb.Provider.MsSql.Tests.csproj" />
  <Project Path="tests/SharpDb.Provider.MySql.Tests/SharpDb.Provider.MySql.Tests.csproj" />
  <Project Path="tests/SharpDb.Provider.Oracle.Tests/SharpDb.Provider.Oracle.Tests.csproj" />
  <Project Path="tests/SharpDb.Provider.PostgreSql.Tests/SharpDb.Provider.PostgreSql.Tests.csproj" />
  <Project Path="tests/SharpDb.Provider.Sqlite.Tests/SharpDb.Provider.Sqlite.Tests.csproj" />
  <Project Path="tests/SharpDb.Tests/SharpDb.Tests.csproj" />

</Solution>
