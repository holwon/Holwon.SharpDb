<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MySQL Provider. It owns its Driver outright: MySqlConnector is referenced
    here and nowhere else, so replacing or adding a database type never reaches
    Core (ADR 0004).
  -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDb.Abstractions\SharpDb.Abstractions.csproj" />
  </ItemGroup>

</Project>
