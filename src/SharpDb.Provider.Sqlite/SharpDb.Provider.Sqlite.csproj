<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SQLite Provider. It owns its Driver outright: Microsoft.Data.Sqlite is
    referenced here and nowhere else, so replacing or adding a database type
    never reaches Core (ADR 0004).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDb.Abstractions\SharpDb.Abstractions.csproj" />
  </ItemGroup>

</Project>
