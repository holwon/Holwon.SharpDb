<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    This repository restores only from nuget.org.

    The <clear /> is load-bearing: NuGet merges package sources from every config
    up the chain (machine, user, repository). A user/machine-level config that adds
    a second source would otherwise leak in here, and Central Package Management
    (ManagePackageVersionsCentrally in Directory.Packages.props) warns NU1507 for
    every project whenever more than one source is visible. Clearing the inherited
    sources and declaring a single one is what keeps that warning away — and keeps
    this repository's restores from ever touching a feed it did not choose.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
