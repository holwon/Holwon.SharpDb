<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mirrors the SharpDb.Provider.Sqlite layer: integration tests drive the
    Provider's own four members against a real (in-memory) database.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpDb.Provider.Sqlite\SharpDb.Provider.Sqlite.csproj" />
  </ItemGroup>

</Project>
