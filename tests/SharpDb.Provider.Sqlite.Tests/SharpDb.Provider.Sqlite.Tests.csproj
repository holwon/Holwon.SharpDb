<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mirrors the SharpDb.Provider.Sqlite layer: integration tests drive the
    Provider's own members against a real SQLite database in a temporary file.
    A file, not an in-memory database, because the Provider opens every
    connection in Mode=ReadOnly and a shared-cache in-memory database cannot be
    reopened in that mode; see SqliteTestDatabase for the measurements.

    It also drives Core's query Tool on a connection this Provider opened. The
    spec's second test seam is "the Provider, against a real database", and its
    coverage list names query execution, parameters and the row limit — so the
    query behaviour is asserted here, where a real database exists, rather than
    in SharpDb.Core.Tests, which has none.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpDb.Core\SharpDb.Core.csproj" />
    <ProjectReference Include="..\..\src\SharpDb.Provider.Sqlite\SharpDb.Provider.Sqlite.csproj" />
    <ProjectReference Include="..\SharpDb.Provider.Contract\SharpDb.Provider.Contract.csproj" />
  </ItemGroup>

</Project>
